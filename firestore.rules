rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Community Spots: Titik temuan komunitas, review, tips tersembunyi
    match /communitySpots/{spotId} {
      // Semua pengguna (termasuk yang belum login) bisa melihat pin di peta
      allow read: if true;

      // Pengguna yang login bisa membuat spot baru dengan authorId miliknya
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;

      // Pengguna yang login bisa mengupdate (misal: tombol 'Membantu' atau melaporkan spot)
      allow update: if isAuthenticated();

      // Hanya pembuat yang dapat menghapus spot miliknya
      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
    }

    // Profil pengguna & progres gamifikasi (XP, situs yang dikunjungi)
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Situs bersejarah & chapter kurasi
    match /historicalSites/{siteId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /chapters/{chapterId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Koleksi Spear (gamifikasi AR)
    match /spears/{spearId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /spearCollections/{claimId} {
      allow read, write: if isAuthenticated();
    }
  }
}
